        837 +  // Modern Navigation System
        838 +  function initializeNavigation() {
        839 +    const headers = document.querySelectorAll('h2, h3');
        840 +    const tocItems = [];
        841 +    
        842 +    headers.forEach((header, index) => {
        843 +      const id = `section-${index}`;
        844 +      header.id = id;
        845 +      
        846 +      const anchor = document.createElement('a');
        847 +      anchor.href = `#${id}`;
        848 +      anchor.className = 'anchor-link';
        849 +      anchor.innerHTML = '🔗';
        850 +      anchor.style.cssText = 'margin-left: 8px; opacity: 0; 
            + transition: opacity 0.2s; text-decoration: none;';
        851 +      header.appendChild(anchor);
        852 +      
        853 +      header.addEventListener('mouseenter', () => 
            + anchor.style.opacity = '1');
        854 +      header.addEventListener('mouseleave', () => 
            + anchor.style.opacity = '0');
        855 +      
        856 +      tocItems.push({
        857 +        text: header.textContent.replace('🔗', '').trim(),
        858 +        id: id,
        859 +        level: header.tagName
        860 +      });
        861 +    });
        862 +    
        863 +    window.tocItems = tocItems;
        864 +  }
        865 +  
        866 +  function toggleTableOfContents() {
