        910 +  
        911 +  function closeTOC() {
        912 +    document.getElementById('tocModal').style.display = 'none';
        913 +  }
        914 +  
        915 +  // Progress Tracking
        916 +  function initializeProgressTracking() {
        917 +    const observer = new IntersectionObserver(
        918 +      (entries) => {
        919 +        entries.forEach(entry => {
        920 +          if (entry.isIntersecting) {
        921 +            updateProgress(entry.target);
        922 +          }
        923 +        });
        924 +      },
        925 +      { threshold: 0.3 }
        926 +    );
        927 +    
        928 +    document.querySelectorAll('h2').forEach(header => {
        929 +      observer.observe(header);
        930 +    });
        931 +    
        932 +    // Restore saved progress
        933 +    const savedProgress = 
            + localStorage.getItem('neurofit-progress');
        934 +    if (savedProgress) {
        935 +      const progressBar = 
            + document.getElementById('progressBar');
        936 +      const progressText = 
            + document.getElementById('progressText');
        937 +      if (progressBar) progressBar.style.width = 
            + `${savedProgress}%`;
        938 +      if (progressText) progressText.textContent = 
            + `${savedProgress}% Complete`;
        939 +    }
        940 +  }
        941 +  
        942 +  function updateProgress(element) {
        943 +    const allHeaders = 
            + Array.from(document.querySelectorAll('h2'));
        944 +    const currentIndex = allHeaders.indexOf(element);
        945 +    const progress = Math.round(((currentIndex + 1) / 
            + allHeaders.length) * 100);
        946 +    
        947 +    const progressBar = document.getElementById('progressBar');
        948 +    const progressText = 
            + document.getElementById('progressText');
        949 +    
        950 +    if (progressBar) progressBar.style.width = `${progress}%`;
        951 +    if (progressText) progressText.textContent = `${progress}% 
            + Complete`;
        952 +    
        953 +    localStorage.setItem('neurofit-progress', 
            + progress.toString());
        954 +  }
        955 +  
        956 +  // Interactive Elements
        957 +  function initializeInteractiveElements() {
        958 +    document.querySelectorAll('.rpe-item').forEach(item => {
        959 +      item.addEventListener('click', () => {
        960 +        const rpeMatch = item.textContent.match(/RPE (\d+)/);
        961 +        if (rpeMatch) showRPEInfo(rpeMatch[1]);
        962 +      });
        963 +    });
        964 +    
        965 +    document.querySelectorAll('.module').forEach((module, index)
            +  => {
        966 +      module.addEventListener('click', () => 
            + markModuleAsVisited(index));
        967 +    });
        968 +    
        969 +    restoreVisitedModules();
        970 +  }
        971 +  
        972 +  function showRPEInfo(rpe) {
        973 +    const descriptions = {
        974 +      '6': 'Somewhat hard - could do 4+ more reps. Good for 
            + warm-up sets.',
        975 +      '7': 'Hard - could do 3 more reps. Perfect for volume 
            + work.',
        976 +      '8': 'Very hard - could do 2 more reps. Most working sets 
            + should be here.',
        977 +      '9': 'Extremely hard - 1 more rep possible. Use for top 
            + sets.',
        978 +      '10': 'Maximum effort - no more reps possible. Rarely used
            +  in training.'
        979 +    };
        980 +    alert(`RPE ${rpe}: ${descriptions[rpe] || 'Invalid RPE 
            + level'}`);
        981 +  }
        982 +  
        983 +  function markModuleAsVisited(moduleIndex) {
        984 +    const visited = 
            + JSON.parse(localStorage.getItem('neurofit-visited') || '[]');
        985 +    if (!visited.includes(moduleIndex)) {
        986 +      visited.push(moduleIndex);
        987 +      localStorage.setItem('neurofit-visited', 
            + JSON.stringify(visited));
        988 +      
        989 +      const module = 
            + document.querySelectorAll('.module')[moduleIndex];
        990 +      if (module && !module.querySelector('.visited-marker')) {
        991 +        module.style.borderLeft = '4px solid var(--success)';
        992 +        module.insertAdjacentHTML('afterbegin', '<span 
            + class="visited-marker" style="color: var(--success); 
            + font-weight: bold;">✓ </span>');
        993 +      }
        994 +    }
        995 +  }
        996 +  
        997 +  function restoreVisitedModules() {
        998 +    const visited = 
            + JSON.parse(localStorage.getItem('neurofit-visited') || '[]');
        999 +    visited.forEach(index => markModuleAsVisited(index));
       1000 +  }
