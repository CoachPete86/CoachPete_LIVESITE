       704 +  function updateCyclePhase(daysSinceStart) {
       705 +    const cyclePhaseEl = document.getElementById('cyclePhase');
       706 +    let phase, emoji;
       707 +    
       708 +    if (daysSinceStart <= 5) {
       709 +      phase = 'Menstrual Phase';
       710 +      emoji = '🔴';
       711 +    } else if (daysSinceStart <= 13) {
       712 +      phase = 'Follicular Phase';
       713 +      emoji = '🌱';
       714 +    } else if (daysSinceStart <= 16) {
       715 +      phase = 'Ovulatory Phase';
       716 +      emoji = '⭐';
       717 +    } else {
       718 +      phase = 'Luteal Phase';
       719 +      emoji = '🌙';
       720 +    }
       721 +    
       722 +    if (cyclePhaseEl) {
       723 +      cyclePhaseEl.innerHTML = `${emoji} ${phase}`;
       724 +    }
       725 +  }
