       799 +  function initializeNavigation() {
       800 +    const headers = document.querySelectorAll('h2, h3');
       801 +    headers.forEach((header, index) => {
       802 +      header.id = `section-${index}`;
       803 +      header.style.scrollMarginTop = '100px';
       804 +    });
       805 +  }
       806 +  
       807 +  function toggleTableOfContents() {
       808 +    let tocModal = document.getElementById('tocModal');
       809 +    
       810 +    if (!tocModal) {
       811 +      const headers = Array.from(document.querySelectorAll('h2, 
           + h3'));
       812 +      const tocItems = headers.map((header, index) => ({
       813 +        text: header.textContent.trim(),
       814 +        id: `section-${index}`,
       815 +        level: header.tagName
       816 +      }));
       817 +      
       818 +      tocModal = document.createElement('div');
       819 +      tocModal.id = 'tocModal';
       820 +      tocModal.style.cssText = `
       821 +        position: fixed; top: 0; left: 0; width: 100%; height: 
           + 100%;
       822 +        background: rgba(0, 0, 0, 0.5); z-index: 1000;
       823 +        display: flex; align-items: center; justify-content: 
           + center;
       824 +      `;
       825 +      
       826 +      const tocContent = `
       827 +        <div style="background: white; padding: 30px; 
           + border-radius: 12px; max-width: 500px; max-height: 80vh; 
           + overflow-y: auto;">
       828 +          <div style="display: flex; align-items: center; 
           + justify-content: space-between; margin-bottom: 20px;">
       829 +            <h3 style="margin: 0; color: var(--primary);">Table 
           + of Contents</h3>
       830 +            <button onclick="closeTOC()" style="background: none;
           +  border: none; font-size: 24px; cursor: pointer;">×</button>
       831 +          </div>
       832 +          <div>
       833 +            ${tocItems.map(item => `
       834 +              <div style="padding: 8px 0; cursor: pointer; 
           + border-bottom: 1px solid #eee; padding-left: ${item.level === 
           + 'H3' ? '20px' : '0'};">
       835 +                <a href="#${item.id}" onclick="closeTOC()" 
           + style="text-decoration: none; color: 
           + var(--secondary);">${item.text}</a>
       836 +              </div>
       837 +            `).join('')}
       838 +          </div>
       839 +        </div>
       840 +      `;
       841 +      
       842 +      tocModal.innerHTML = tocContent;
       843 +      document.body.appendChild(tocModal);
       844 +    }
       845 +    
       846 +    tocModal.style.display = tocModal.style.display === 'none' ? 
           + 'flex' : 'none';
       847 +  }
       848 +  
       849 +  function closeTOC() {
       850 +    document.getElementById('tocModal').style.display = 'none';
       851 +  }
       852 +  
