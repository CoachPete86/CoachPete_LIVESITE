        829 +  <script>
        830 +  document.addEventListener('DOMContentLoaded', function() {
        831 +    initializeNavigation();
        832 +    initializeProgressTracking();
        833 +    initializeInteractiveElements();
        834 +    initializeDarkMode();
        835 +  });
        836 +  
        837 +  // Modern Navigation System
        838 +  function initializeNavigation() {
        839 +    const headers = document.querySelectorAll('h2, h3');
        840 +    const tocItems = [];
        841 +    
        842 +    headers.forEach((header, index) => {
        843 +      const id = `section-${index}`;
        844 +      header.id = id;
        845 +      
        846 +      const anchor = document.createElement('a');
        847 +      anchor.href = `#${id}`;
        848 +      anchor.className = 'anchor-link';
        849 +      anchor.innerHTML = '🔗';
        850 +      anchor.style.cssText = 'margin-left: 8px; opacity: 0; 
            + transition: opacity 0.2s; text-decoration: none;';
        851 +      header.appendChild(anchor);
        852 +      
        853 +      header.addEventListener('mouseenter', () => 
            + anchor.style.opacity = '1');
        854 +      header.addEventListener('mouseleave', () => 
            + anchor.style.opacity = '0');
        855 +      
        856 +      tocItems.push({
        857 +        text: header.textContent.replace('🔗', '').trim(),
        858 +        id: id,
        859 +        level: header.tagName
        860 +      });
        861 +    });
        862 +    
        863 +    window.tocItems = tocItems;
        864 +  }
        865 +  
        866 +  function toggleTableOfContents() {
        867 +    let tocModal = document.getElementById('tocModal');
        868 +    
        869 +    if (!tocModal) {
        870 +      tocModal = document.createElement('div');
        871 +      tocModal.id = 'tocModal';
        872 +      tocModal.style.cssText = `
        873 +        position: fixed; top: 0; left: 0; width: 100%; height: 
            + 100%;
        874 +        background: rgba(0, 0, 0, 0.5); z-index: 1000;
        875 +        display: flex; align-items: center; justify-content: 
            + center;
        876 +      `;
        877 +      
        878 +      const tocContent = document.createElement('div');
        879 +      tocContent.style.cssText = `
        880 +        background: white; padding: 30px; border-radius: 12px;
        881 +        max-width: 500px; max-height: 80vh; overflow-y: auto;
        882 +        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
        883 +      `;
        884 +      
        885 +      tocContent.innerHTML = `
        886 +        <div style="display: flex; align-items: center; 
            + justify-content: space-between; margin-bottom: 20px;">
        887 +          <h3 style="margin: 0; color: var(--primary);">Table of
            +  Contents</h3>
        888 +          <button onclick="closeTOC()" style="background: none; 
            + border: none; font-size: 24px; cursor: pointer;">×</button>
        889 +        </div>
        890 +        <div id="tocList"></div>
        891 +      `;
        892 +      
        893 +      tocModal.appendChild(tocContent);
        894 +      document.body.appendChild(tocModal);
        895 +      
        896 +      const tocList = document.getElementById('tocList');
        897 +      window.tocItems.forEach(item => {
        898 +        const tocItem = document.createElement('div');
        899 +        tocItem.style.cssText = `
        900 +          padding: 8px 0; cursor: pointer; border-bottom: 1px 
            + solid #eee;
        901 +          padding-left: ${item.level === 'H3' ? '20px' : '0'};
        902 +        `;
        903 +        tocItem.innerHTML = `<a href="#${item.id}" 
            + onclick="closeTOC()" style="text-decoration: none; color: 
            + var(--secondary);">${item.text}</a>`;
        904 +        tocList.appendChild(tocItem);
        905 +      });
        906 +    }
        907 +    
        908 +    tocModal.style.display = tocModal.style.display === 'none' ?
            +  'flex' : 'none';
        909 +  }
        910 +  
        911 +  function closeTOC() {
        912 +    document.getElementById('tocModal').style.display = 'none';
        913 +  }
        914 +  
        915 +  // Progress Tracking
        916 +  function initializeProgressTracking() {
        917 +    const observer = new IntersectionObserver(
        918 +      (entries) => {
        919 +        entries.forEach(entry => {
        920 +          if (entry.isIntersecting) {
        921 +            updateProgress(entry.target);
        922 +          }
        923 +        });
        924 +      },
        925 +      { threshold: 0.3 }
        926 +    );
        927 +    
        928 +    document.querySelectorAll('h2').forEach(header => {
        929 +      observer.observe(header);
        930 +    });
        931 +    
        932 +    // Restore saved progress
        933 +    const savedProgress = 
            + localStorage.getItem('neurofit-progress');
        934 +    if (savedProgress) {
        935 +      const progressBar = 
            + document.getElementById('progressBar');
        936 +      const progressText = 
            + document.getElementById('progressText');
        937 +      if (progressBar) progressBar.style.width = 
            + `${savedProgress}%`;
        938 +      if (progressText) progressText.textContent = 
            + `${savedProgress}% Complete`;
        939 +    }
        940 +  }
        941 +  
        942 +  function updateProgress(element) {
        943 +    const allHeaders = 
            + Array.from(document.querySelectorAll('h2'));
        944 +    const currentIndex = allHeaders.indexOf(element);
        945 +    const progress = Math.round(((currentIndex + 1) / 
            + allHeaders.length) * 100);
        946 +    
        947 +    const progressBar = document.getElementById('progressBar');
        948 +    const progressText = 
            + document.getElementById('progressText');
        949 +    
        950 +    if (progressBar) progressBar.style.width = `${progress}%`;
        951 +    if (progressText) progressText.textContent = `${progress}% 
            + Complete`;
        952 +    
        953 +    localStorage.setItem('neurofit-progress', 
            + progress.toString());
        954 +  }
        955 +  
        956 +  // Interactive Elements
        957 +  function initializeInteractiveElements() {
        958 +    document.querySelectorAll('.rpe-item').forEach(item => {
        959 +      item.addEventListener('click', () => {
        960 +        const rpeMatch = item.textContent.match(/RPE (\d+)/);
        961 +        if (rpeMatch) showRPEInfo(rpeMatch[1]);
        962 +      });
        963 +    });
        964 +    
        965 +    document.querySelectorAll('.module').forEach((module, index)
            +  => {
        966 +      module.addEventListener('click', () => 
            + markModuleAsVisited(index));
        967 +    });
        968 +    
        969 +    restoreVisitedModules();
        970 +  }
        971 +  
        972 +  function showRPEInfo(rpe) {
        973 +    const descriptions = {
        974 +      '6': 'Somewhat hard - could do 4+ more reps. Good for 
            + warm-up sets.',
        975 +      '7': 'Hard - could do 3 more reps. Perfect for volume 
            + work.',
        976 +      '8': 'Very hard - could do 2 more reps. Most working sets 
            + should be here.',
        977 +      '9': 'Extremely hard - 1 more rep possible. Use for top 
            + sets.',
        978 +      '10': 'Maximum effort - no more reps possible. Rarely used
            +  in training.'
        979 +    };
        980 +    alert(`RPE ${rpe}: ${descriptions[rpe] || 'Invalid RPE 
            + level'}`);
        981 +  }
        982 +  
        983 +  function markModuleAsVisited(moduleIndex) {
        984 +    const visited = 
            + JSON.parse(localStorage.getItem('neurofit-visited') || '[]');
        985 +    if (!visited.includes(moduleIndex)) {
        986 +      visited.push(moduleIndex);
        987 +      localStorage.setItem('neurofit-visited', 
            + JSON.stringify(visited));
        988 +      
        989 +      const module = 
            + document.querySelectorAll('.module')[moduleIndex];
        990 +      if (module && !module.querySelector('.visited-marker')) {
        991 +        module.style.borderLeft = '4px solid var(--success)';
        992 +        module.insertAdjacentHTML('afterbegin', '<span 
            + class="visited-marker" style="color: var(--success); 
            + font-weight: bold;">✓ </span>');
        993 +      }
        994 +    }
        995 +  }
        996 +  
        997 +  function restoreVisitedModules() {
        998 +    const visited = 
            + JSON.parse(localStorage.getItem('neurofit-visited') || '[]');
        999 +    visited.forEach(index => markModuleAsVisited(index));
       1000 +  }
       1001 +  
       1002 +  // Dark Mode
       1003 +  function initializeDarkMode() {
       1004 +    const savedTheme = localStorage.getItem('neurofit-theme');
       1005 +    if (savedTheme === 'dark') enableDarkMode();
       1006 +  }
       1007 +  
       1008 +  function toggleDarkMode() {
       1009 +    const isDark = 
            + document.body.classList.contains('dark-mode');
       1010 +    isDark ? disableDarkMode() : enableDarkMode();
       1011 +  }
       1012 +  
       1013 +  function enableDarkMode() {
       1014 +    document.body.classList.add('dark-mode');
       1015 +    localStorage.setItem('neurofit-theme', 'dark');
       1016 +    
       1017 +    const vars = {
       1018 +      '--bg': '#1a1a1a',
       1019 +      '--surface': '#2d2d2d',
       1020 +      '--text': '#ffffff',
       1021 +      '--text-light': '#cccccc',
       1022 +      '--border': '#404040'
       1023 +    };
       1024 +    
       1025 +    Object.entries(vars).forEach(([key, value]) => {
       1026 +      document.documentElement.style.setProperty(key, value);
       1027 +    });
       1028 +    
       1029 +    const btn = 
            + document.querySelector('button[onclick="toggleDarkMode()"]');
       1030 +    if (btn) btn.textContent = '☀️ Light';
       1031 +  }
       1032 +  
       1033 +  function disableDarkMode() {
       1034 +    document.body.classList.remove('dark-mode');
       1035 +    localStorage.setItem('neurofit-theme', 'light');
       1036 +    
       1037 +    const vars = {
       1038 +      '--bg': '#fafafa',
       1039 +      '--surface': '#ffffff',
       1040 +      '--text': '#1f2937',
       1041 +      '--text-light': '#6b7280',
       1042 +      '--border': '#e5e7eb'
       1043 +    };
       1044 +    
       1045 +    Object.entries(vars).forEach(([key, value]) => {
       1046 +      document.documentElement.style.setProperty(key, value);
       1047 +    });
       1048 +    
       1049 +    const btn = 
            + document.querySelector('button[onclick="toggleDarkMode()"]');
       1050 +    if (btn) btn.textContent = '🌙 Dark';
       1051 +  }
       1052 +  
       1053 +  function printPage() {
       1054 +    window.print();
       1055 +  }
       1056 +  
       1057 +  // Keyboard shortcuts
       1058 +  document.addEventListener('keydown', (e) => {
