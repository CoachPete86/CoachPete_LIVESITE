       742 +      `;
       743 +    } else if (daysSinceStart <= 13) {
       744 +      advice = `
       745 +        <p><strong>Follicular Phase (Days 6-13)</strong></p>
       746 +        <ul>
       747 +          <li>Gradually increase training intensity</li>
       748 +          <li>Perfect time for skill acquisition and learning new
