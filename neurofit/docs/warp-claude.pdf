       1060 +      e.preventDefault();
       1061 +      toggleTableOfContents();
       1062 +    }
       1063 +    if (e.altKey && e.key === 'd') {
       1064 +      e.preventDefault();
       1065 +      toggleDarkMode();
       1066 +    }
       1067 +  });
       1068 +  </script>
